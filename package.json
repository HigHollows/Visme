{
  "name": "assistant",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @assistant/desktop exec tsc --noEmit",
    "build:engine": "node scripts/build-sidecar.mjs",
    "smoke:engine": "node scripts/smoke-sidecar.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "dev": "pnpm --filter @assistant/desktop tauri dev",
    "build:app": "node scripts/build-sidecar.mjs && pnpm --filter @assistant/desktop tauri build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
